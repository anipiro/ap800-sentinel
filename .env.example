# Port the website listens on
PORT=4800
# Real seconds before an unacknowledged issue is escalated to the next person
ESCALATE_AFTER_S=20
# Telegram bot token. Leave empty to record Telegram messages without sending them.
TELEGRAM_BOT_TOKEN=
# Token for the read-only REST API (/api/v1/...). Leave empty to keep the API switched off.
API_TOKEN=
# Path of the SQLite database file
DB_PATH=data/sentinel.db
